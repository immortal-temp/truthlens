# TruthLens Backend Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MongoDB Atlas
# Single database, short-lived storage with 20-minute TTL index
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=truthlens
MONGODB_TTL_SECONDS=1200

# LLM Providers (Primary -> Secondary -> Tertiary keys per provider)

# 1. Groq (Primary LLM Provider)
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_MODEL=openai/gpt-oss-120b

# 2. Google Gemini (Secondary LLM Provider)
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-2.5-flash

# 3. OpenRouter (Tertiary LLM Provider)
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# News APIs (Primary, Secondary, Tertiary keys for quota redundancy)
GNEWS_API_KEY=
GNEWS_API_KEY_2=
GNEWS_API_KEY_3=

NEWSDATA_API_KEY=
NEWSDATA_API_KEY_2=
NEWSDATA_API_KEY_3=

NEWSAPI_API_KEY=
NEWSAPI_API_KEY_2=
NEWSAPI_API_KEY_3=

# Demo Mode (Set to false for live searches with real Google News RSS & APIs)
DEMO_MODE=false
