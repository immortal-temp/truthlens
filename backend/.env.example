# TruthLens Backend Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# MongoDB Atlas
# Single database, short-lived storage with 20-minute TTL index
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=truthlens
MONGODB_TTL_SECONDS=1200

# LLM Providers (Primary -> Fallback 1 -> Fallback 2)
# 1. Google Gemini (Primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Groq (Secondary Fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 3. OpenRouter (Tertiary Fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# News APIs
GNEWS_API_KEY=
NEWSDATA_API_KEY=
NEWSAPI_API_KEY=

# Demo Mode (Set to true to use offline fixtures instead of external APIs)
DEMO_MODE=false
